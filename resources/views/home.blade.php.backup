<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filter-form');
    const searchInput = document.querySelector('.search-input'); // Main header search input
    const gridContainer = document.getElementById('product-grid-container');
    const loader = document.getElementById('grid-loader');
    const resultsCount = document.getElementById('results-count');
    
    let debounceTimer;

    function fetchProducts() {
        const formData = new FormData(filterForm);
        const params = new URLSearchParams(formData);
        
        if (searchInput && searchInput.value) {
            params.append('q', searchInput.value);
        }

        loader.classList.remove('d-none');
        loader.classList.add('d-flex');
        
        fetch(`{{ route('home') }}?${params.toString()}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            gridContainer.innerHTML = html;
            gridContainer.appendChild(loader); // Re-append loader for next use
            loader.classList.add('d-none');
            loader.classList.remove('d-flex');
            
            // Sync URL without reload
            window.history.pushState({}, '', `{{ route('home') }}?${params.toString()}`);
        })
        .catch(error => {
            console.error('Error fetching products:', error);
            loader.classList.add('d-none');
        });
    }

    // Live search as you type
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(fetchProducts, 500);
        });
        
        // Prevent form submission if in header
        const searchForm = searchInput.closest('form');
        if (searchForm) {
            searchForm.addEventListener('submit', function(e) {
                e.preventDefault();
                fetchProducts();
            });
        }
    }

    // Filter changes
    filterForm.addEventListener('change', fetchProducts);
    
    // Price input debouncing
    filterForm.querySelectorAll('input[type="number"]').forEach(input => {
        input.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(fetchProducts, 1000);
        });
    });

    // Reset filters
    document.getElementById('reset-filters').addEventListener('click', function() {
        setTimeout(fetchProducts, 10);
    });

    // Handle AJAX pagination clicks
    document.addEventListener('click', function(e) {
        if (e.target.closest('.ajax-pagination a')) {
            e.preventDefault();
            const url = new URL(e.target.closest('a').href);
            fetchProductsWithUrl(url.toString());
        }
    });

    function fetchProductsWithUrl(url) {
        loader.classList.remove('d-none');
        loader.classList.add('d-flex');
        
        fetch(url, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            gridContainer.innerHTML = html;
            gridContainer.appendChild(loader);
            loader.classList.add('d-none');
            window.scrollTo({ top: gridContainer.offsetTop - 120, behavior: 'smooth' });
        });
    }
});
</script>

